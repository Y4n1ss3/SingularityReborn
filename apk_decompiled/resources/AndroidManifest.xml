<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:versionCode="49"
    android:versionName="1.0.7.9"
    android:compileSdkVersion="36"
    android:compileSdkVersionCodename="16"
    package="com.lumi.singularity"
    platformBuildVersionCode="36"
    platformBuildVersionName="16">
    <uses-sdk
        android:minSdkVersion="29"
        android:targetSdkVersion="36"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"/>
    <queries>
        <package android:name="com.oculus.guidebook"/>
        <package android:name="com.meta.shell.env.footprint.haven2025"/>
        <package android:name="com.meta.shell.env.vista.calming"/>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
    </queries>
    <permission
        android:name="com.lumi.singularity.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature"/>
    <uses-permission android:name="com.lumi.singularity.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"/>
    <application
        android:theme="@style/Theme.Singularity"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher_foreground"
        android:allowBackup="true"
        android:supportsRtl="true"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <activity
            android:theme="@style/Theme.Singularity"
            android:name="com.lumi.singularity.ui.activities.MainActivity"
            android:exported="true"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation|keyboardHidden">
            <layout
                android:defaultWidth="500dp"
                android:defaultHeight="800dp"/>
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="AIO Tweaks"
            android:name="com.lumi.singularity.ui.activities.TweaksActivity"
            android:exported="false"/>
        <activity
            android:name="com.lumi.singularity.ui.activities.AdbRootActivity"
            android:exported="false"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation|keyboardHidden"/>
        <activity
            android:name="com.lumi.singularity.ui.activities.AdbActivity"
            android:exported="false"
            android:configChanges="smallestScreenSize|screenSize|screenLayout|orientation|keyboardHidden"/>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="Install Apps"
            android:name="com.lumi.singularity.ui.activities.AppsActivity"
            android:exported="false"/>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="Custom LED Color"
            android:name="com.lumi.singularity.ui.activities.LedColorActivity"
            android:exported="false"/>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="Root Terminal"
            android:name="com.lumi.singularity.ui.activities.TerminalActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"/>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="Domain Blocker"
            android:name="com.lumi.singularity.ui.activities.DomainBlockerActivity"
            android:exported="false"/>
        <activity
            android:theme="@style/Theme.Singularity"
            android:label="Controllers"
            android:name="com.lumi.singularity.ui.activities.ControllerInfoActivity"
            android:exported="false"/>
        <service
            android:name="com.lumi.singularity.system.DnsBlockerService"
            android:permission="android.permission.BIND_VPN_SERVICE"
            android:exported="true"
            android:foregroundServiceType="specialUse">
            <intent-filter>
                <action android:name="android.net.VpnService"/>
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="VPN"/>
        </service>
        <service
            android:name="com.lumi.singularity.system.TweakService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice"/>
        <receiver
            android:name="com.lumi.singularity.system.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
        </receiver>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:exported="false"
            android:authorities="com.lumi.singularity.provider"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"/>
        </provider>
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:exported="false"
            android:authorities="com.lumi.singularity.androidx-startup">
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup"/>
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup"/>
        </provider>
        <uses-library
            android:name="androidx.window.extensions"
            android:required="false"/>
        <uses-library
            android:name="androidx.window.sidecar"
            android:required="false"/>
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:permission="android.permission.DUMP"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE"/>
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
